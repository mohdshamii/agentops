# Hugging Face Settings (Get your free access token at https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_DEFAULT_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_CODER_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
